<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- App Sandbox: the app (and its sign-in cookies) live in a private container other apps can't read. -->
  <key>com.apple.security.app-sandbox</key><true/>
  <!-- Outgoing HTTPS only (YouTube Music, Google sign-in, artwork, LRCLIB). No incoming connections. -->
  <key>com.apple.security.network.client</key><true/>
  <!-- Read audio files you choose (or drop on the window) to upload them to YouTube Music. -->
  <key>com.apple.security.files.user-selected.read-only</key><true/>
  <!-- The one folder the desktop widgets read: what's playing and its cover. -->
  <key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
  <array><string>/Library/Application Support/Encore Widget/</string></array>
</dict>
</plist>
